{
  "functions": {
    "api/router.php": {
      "runtime": "vercel-php@0.7.4",
      "includeFiles": "{index.php,admin.php,api.php,src/**,data/**}"
    }
  },
  "routes": [
    { "src": "/(index\\.php|admin\\.php|api\\.php)?", "dest": "/api/router.php" },
    { "src": "/(src|data|tools|api)(/.*)?", "status": 404 },
    { "src": "/(.*\\.(php|bat|sqlite|md))", "status": 404 },
    { "handle": "filesystem" },
    { "src": "/(.*)", "status": 404 }
  ]
}
